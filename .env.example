# Copy this file to .env and fill in the values. .env is gitignored.

# Aptabase anonymous-usage-analytics App Key (https://aptabase.com).
# Format: A-US-XXXXXXXXXX or A-EU-XXXXXXXXXX. Baked into the desktop binary at
# build time by src-tauri/build.rs. Leave empty to disable analytics.
APTABASE_KEY=

# Optional override for the signed updater manifest. Keep this aligned with the
# endpoint in src-tauri/tauri.conf.json. The manifest may include
# `minimumSupportedVersion` to require operators to install that release.
VITE_UPDATE_MANIFEST_URL=https://lumenlivedl.94streetstudio.xyz/latest.json
